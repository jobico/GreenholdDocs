---
// A product card on the home page: the product's own icon, a linked title and a short text.
// The whole card is one link. Brand icons are all rights reserved (see README).
interface Props {
  title: string;
  href: string;
  icon: string; // file name in /brand without extension, e.g. "dispatch"
}
const { title, href, icon } = Astro.props;
---

<a class="product-card not-content" href={href} style={`--product: var(--gh-${icon})`}>
  <span class="icon" aria-hidden="true">
    <img class="light" src={`/brand/${icon}.svg`} alt="" width="40" height="40" />
    <img class="dark" src={`/brand/${icon}-dark.svg`} alt="" width="40" height="40" />
  </span>
  <span class="body">
    <span class="title">{title}</span>
    <span class="text"><slot /></span>
  </span>
</a>

<style>
  .product-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--gh-surface);
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .product-card:hover,
  .product-card:focus-visible {
    border-color: var(--product, var(--sl-color-accent));
  }
  .product-card:hover .title,
  .product-card:focus-visible .title {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
  }
  .icon img {
    display: block;
  }
  .icon .dark {
    display: none;
  }
  :global([data-theme='dark']) .icon .light {
    display: none;
  }
  :global([data-theme='dark']) .icon .dark {
    display: block;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .title {
    font-size: var(--sl-text-h4);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .text {
    color: var(--sl-color-gray-2);
    line-height: 1.55;
  }
</style>
